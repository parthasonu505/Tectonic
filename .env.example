# Configure Google Gemini API Key and Model (gemini-3.6-flash)
GOOGLE_API_KEY= GOOGLE_API_KEY
GEMINI_API_KEY= GEMINI_API_KEY
GEMINI_MODEL=gemini-3.6-flash

# Where generated agent projects are written (default: ./generated_agents)
AGENT_BUILDER_OUTPUT_DIR=./generated_agents
# Where trace logs are written (default: ./logs)
AGENT_BUILDER_LOG_DIR=./logs
# DEBUG | INFO | WARNING
AGENT_BUILDER_TRACE_LEVEL=INFO
# Set to 1 to also print OpenTelemetry spans to the console
AGENT_BUILDER_OTEL_CONSOLE=0
# Optional: use Tavily instead of DuckDuckGo for web_search
TAVILY_API_KEY=
